{
  "name": "@pixelcraft/validation",
  "version": "1.0.0",
  "private": true,
  "description": "Shared validation utilities and schemas using Zod for PixelCraft POS",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@pixelcraft/config": "workspace:*",
    "@pixelcraft/types": "workspace:*",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
