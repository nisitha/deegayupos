{
  "name": "@pixelcraft/database",
  "version": "1.0.0",
  "private": true,
  "description": "Prisma ORM schema, migrations, RLS policies, and database client for PixelCraft POS",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx src/seed.ts",
    "import:deegayu": "tsx src/import-deegayu.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@pixelcraft/config": "workspace:*",
    "@pixelcraft/types": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.4",
    "prisma": "^6.4.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}

