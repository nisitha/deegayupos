datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT_ADMIN
  AUDITOR
}

enum BusinessStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ProductType {
  STANDARD
  VARIABLE
  SERVICE
  BUNDLE
}

enum OrderType {
  RETAIL_WALKIN
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum SaleStatus {
  COMPLETED
  HELD
  VOIDED
  REFUNDED
}

enum SalePaymentMethod {
  CASH
  CARD
  QR_PAYMENT
  BANK_TRANSFER
  STORE_CREDIT
}

enum SalePaymentStatus {
  SUCCESS
  PENDING
  FAILED
}

enum ReceiptPaperSize {
  MM_58
  MM_80
  A4
}

enum StockMovementType {
  SALE
  PURCHASE_RECEIPT
  TRANSFER_DISPATCH
  TRANSFER_RECEIPT
  ADJUSTMENT_ADD
  ADJUSTMENT_SUB
  RETURN_RESTOCK
  DAMAGE_LOSS
}

enum StockAdjustmentReason {
  PHYSICAL_COUNT
  DAMAGED
  EXPIRED
  LOST_STOLEN
  CORRECTION
}

enum StockAdjustmentStatus {
  APPLIED
  REVERSED
}

enum StockTransferStatus {
  PENDING
  DISPATCHED
  RECEIVED
  CANCELLED
}

// ==========================================
// 1. PLATFORM LAYER
// ==========================================

model PlatformUser {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique @db.VarChar(255)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  role         PlatformRole @default(SUPER_ADMIN)
  isActive     Boolean      @default(true) @map("is_active")
  mfaSecret    String?      @map("mfa_secret") @db.VarChar(255)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  @@map("platform_users")
}

model PlatformSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(128)
  value       Json
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// ==========================================
// 2. TENANT & ORGANIZATION LAYER
// ==========================================

model Business {
  id           String         @id @default(uuid()) @db.Uuid
  name         String         @db.VarChar(255)
  slug         String         @unique @db.VarChar(64)
  legalName    String?        @map("legal_name") @db.VarChar(255)
  businessType String         @default("RETAIL") @map("business_type") @db.VarChar(64)
  status       BusinessStatus @default(TRIAL)
  currency     String         @default("LKR") @db.VarChar(10)
  timezone     String         @default("Asia/Colombo") @db.VarChar(64)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  deletedAt    DateTime?      @map("deleted_at")

  // Relations
  settings        BusinessSetting?
  branches        Branch[]
  warehouses      Warehouse[]
  registers       Register[]
  memberships     BusinessMembership[]
  roles           Role[]
  subscriptions   Subscription[]
  auditLogs       AuditLog[]
  idempotencyKeys IdempotencyKey[]
  categories      Category[]
  brands          Brand[]
  units           Unit[]
  products        Product[]
  productVariants ProductVariant[]
  sales           Sale[]
  saleItems       SaleItem[]
  salePayments    SalePayment[]
  heldCarts       HeldCart[]
  stockLevels     StockLevel[]
  stockMovements  StockMovement[]
  stockAdjustments StockAdjustment[]
  stockAdjustmentItems StockAdjustmentItem[]
  stockTransfers  StockTransfer[]
  stockTransferItems StockTransferItem[]

  @@index([slug])
  @@index([status])
  @@index([createdAt])
  @@map("businesses")
}

model BusinessSetting {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @unique @map("tenant_id") @db.Uuid
  invoicePrefix  String    @default("INV-") @map("invoice_prefix") @db.VarChar(20)
  taxNumber      String?   @map("tax_number") @db.VarChar(64)
  taxRate        Decimal   @default(0.00) @map("tax_rate") @db.Decimal(5, 2)
  isTaxInclusive Boolean   @default(false) @map("is_tax_inclusive")
  enableLoyalty       Boolean          @default(false) @map("enable_loyalty")
  receiptPaperSize    ReceiptPaperSize @default(MM_80) @map("receipt_paper_size")
  showLogoOnReceipt   Boolean          @default(true) @map("show_logo_on_receipt")
  showTaxDetails      Boolean          @default(true) @map("show_tax_details")
  showBarcodeOnReceipt Boolean         @default(true) @map("show_barcode_on_receipt")
  receiptHeader       String?          @map("receipt_header") @db.Text
  receiptFooter       String?          @map("receipt_footer") @db.Text
  returnPolicyText    String?          @map("return_policy_text") @db.Text
  negativeStockPolicy String           @default("DISALLOW") @map("negative_stock_policy") @db.VarChar(32)
  allowNegativeStock  Boolean          @default(false) @map("allow_negative_stock")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, id])
  @@map("business_settings")
}

model Branch {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String    @db.VarChar(32)
  name      String    @db.VarChar(255)
  address   String?   @db.Text
  phone     String?   @db.VarChar(32)
  isPrimary Boolean   @default(false) @map("is_primary")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  business    Business             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouses  Warehouse[]
  registers   Register[]
  memberships BusinessMembership[]
  sales       Sale[]
  heldCarts   HeldCart[]

  @@unique([tenantId, code])
  @@index([tenantId, id])
  @@index([tenantId, createdAt])
  @@map("branches")
}

model Warehouse {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  branchId  String    @map("branch_id") @db.Uuid
  name      String    @db.VarChar(255)
  isDefault Boolean   @default(false) @map("is_default")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  stockLevels      StockLevel[]
  stockMovements   StockMovement[]
  stockAdjustments StockAdjustment[]
  sourceTransfers  StockTransfer[]   @relation("TransferSourceWarehouse")
  targetTransfers  StockTransfer[]   @relation("TransferTargetWarehouse")

  @@index([tenantId, id])
  @@index([tenantId, branchId])
  @@index([tenantId, createdAt])
  @@map("warehouses")
}

model Register {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  branchId  String    @map("branch_id") @db.Uuid
  name      String    @db.VarChar(128)
  code      String    @db.VarChar(32)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sales    Sale[]
  heldCarts HeldCart[]

  @@unique([tenantId, branchId, code])
  @@index([tenantId, id])
  @@index([tenantId, createdAt])
  @@map("registers")
}

// ==========================================
// 3. ACCESS & RBAC LAYER
// ==========================================

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(255)
  phone        String?   @db.VarChar(32)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  memberships BusinessMembership[]
  auditLogs   AuditLog[]
  sales       Sale[]
  heldCarts   HeldCart[]
  stockAdjustments StockAdjustment[]
  stockTransfers   StockTransfer[]

  @@index([email])
  @@map("users")
}

model BusinessMembership {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  roleId          String           @map("role_id") @db.Uuid
  defaultBranchId String?          @map("default_branch_id") @db.Uuid
  status          MembershipStatus @default(ACTIVE)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")

  business      Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  defaultBranch Branch?  @relation(fields: [defaultBranchId], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId])
  @@index([tenantId, id])
  @@index([tenantId, roleId])
  @@map("business_memberships")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  code        String    @db.VarChar(64)
  name        String    @db.VarChar(128)
  description String?   @db.Text
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  business    Business?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships BusinessMembership[]

  @@unique([tenantId, code])
  @@index([tenantId, id])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(128)
  name        String   @db.VarChar(128)
  module      String   @db.VarChar(64)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ==========================================
// 4. SAAS & SUBSCRIPTION LAYER
// ==========================================

model Plan {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique @db.VarChar(64)
  name           String   @db.VarChar(128)
  description    String?  @db.Text
  monthlyPrice   Decimal  @map("monthly_price") @db.Decimal(12, 2)
  annualPrice    Decimal  @map("annual_price") @db.Decimal(12, 2)
  maxProducts    Int      @default(500) @map("max_products")
  maxBranches    Int      @default(1) @map("max_branches")
  maxUsers       Int      @default(2) @map("max_users")
  maxRegisters   Int      @default(1) @map("max_registers")
  enabledModules Json     @default("[\"pos\", \"inventory\"]") @map("enabled_modules")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id           String             @id @default(uuid()) @db.Uuid
  businessId   String             @map("business_id") @db.Uuid
  planId       String             @map("plan_id") @db.Uuid
  status       SubscriptionStatus @default(TRIAL)
  startsAt     DateTime           @default(now()) @map("starts_at")
  endsAt       DateTime?          @map("ends_at")
  trialEndsAt  DateTime?          @map("trial_ends_at")
  billingCycle BillingCycle       @default(MONTHLY) @map("billing_cycle")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  business Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments SubscriptionPayment[]

  @@index([businessId, status])
  @@map("subscriptions")
}

model SubscriptionPayment {
  id             String        @id @default(uuid()) @db.Uuid
  subscriptionId String        @map("subscription_id") @db.Uuid
  amount         Decimal       @db.Decimal(14, 4)
  currency       String        @default("USD") @db.VarChar(10)
  status         PaymentStatus @default(PENDING)
  paymentMethod  String        @map("payment_method") @db.VarChar(64)
  reference      String?       @db.VarChar(255)
  proofUrl       String?       @map("proof_url") @db.VarChar(512)
  verifiedAt     DateTime?     @map("verified_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, status])
  @@map("subscription_payments")
}

// ==========================================
// 5. SECURITY & INTEGRITY LAYER
// ==========================================

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(128)
  entity    String   @db.VarChar(128)
  entityId  String?  @map("entity_id") @db.Uuid
  oldValues Json?    @map("old_values")
  newValues Json?    @map("new_values")
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at")

  business Business? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, id])
  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model IdempotencyKey {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  key          String    @db.VarChar(255)
  endpoint     String    @db.VarChar(255)
  responseCode Int?      @map("response_code")
  responseBody Json?     @map("response_body")
  lockedAt     DateTime  @default(now()) @map("locked_at")
  expiresAt    DateTime  @map("expires_at")

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, expiresAt])
  @@map("idempotency_keys")
}

// ==========================================
// 6. PRODUCT & CATALOGUE LAYER
// ==========================================

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String    @db.VarChar(255)
  slug        String    @db.VarChar(255)
  description String?   @db.Text
  parentId    String?   @map("parent_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  business Business   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId, id])
  @@index([tenantId, parentId])
  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String    @db.VarChar(255)
  slug      String    @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  business Business  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId, id])
  @@map("brands")
}

model Unit {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String    @db.VarChar(128)
  shortCode String    @map("short_code") @db.VarChar(32)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  business Business  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, shortCode])
  @@index([tenantId, id])
  @@map("units")
}

model Product {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  categoryId     String?     @map("category_id") @db.Uuid
  brandId        String?     @map("brand_id") @db.Uuid
  unitId         String?     @map("unit_id") @db.Uuid
  name           String      @db.VarChar(255)
  slug           String      @db.VarChar(255)
  sku            String      @db.VarChar(128)
  barcode        String?     @db.VarChar(128)
  description    String?     @db.Text
  type           ProductType @default(STANDARD)
  costPrice      Decimal     @default(0.00) @map("cost_price") @db.Decimal(12, 2)
  retailPrice    Decimal     @map("retail_price") @db.Decimal(12, 2)
  wholesalePrice Decimal?    @map("wholesale_price") @db.Decimal(12, 2)
  alertQuantity  Int         @default(5) @map("alert_quantity")
  isTrackStock   Boolean     @default(true) @map("is_track_stock")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  deletedAt      DateTime?   @map("deleted_at")

  business Business         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand    Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit     Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  variants ProductVariant[]
  saleItems SaleItem[]
  stockLevels          StockLevel[]
  stockMovements       StockMovement[]
  stockAdjustmentItems StockAdjustmentItem[]
  stockTransferItems   StockTransferItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, id])
  @@index([tenantId, barcode])
  @@index([tenantId, sku])
  @@index([tenantId, name])
  @@index([tenantId, categoryId])
  @@index([tenantId, brandId])
  @@index([tenantId, isActive])
  @@index([tenantId, createdAt])
  @@map("products")
}

model ProductVariant {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  name        String    @db.VarChar(255)
  sku         String    @db.VarChar(128)
  barcode     String?   @db.VarChar(128)
  costPrice   Decimal?  @map("cost_price") @db.Decimal(12, 2)
  retailPrice Decimal?  @map("retail_price") @db.Decimal(12, 2)
  attributes  Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  business  Business   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems SaleItem[]
  stockLevels          StockLevel[]
  stockMovements       StockMovement[]
  stockAdjustmentItems StockAdjustmentItem[]
  stockTransferItems   StockTransferItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, id])
  @@index([tenantId, productId])
  @@index([tenantId, barcode])
  @@index([tenantId, sku])
  @@map("product_variants")
}

// ==========================================
// 5. POS & SALES ENGINE
// ==========================================

model Sale {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  branchId       String      @map("branch_id") @db.Uuid
  registerId     String?     @map("register_id") @db.Uuid
  cashierId      String      @map("cashier_id") @db.Uuid
  customerId     String?     @map("customer_id") @db.Uuid
  customerName   String?     @map("customer_name") @db.VarChar(255)
  invoiceNumber  String      @map("invoice_number") @db.VarChar(64)
  orderType      OrderType   @default(RETAIL_WALKIN) @map("order_type")
  tableNumber    String?     @map("table_number") @db.VarChar(32)
  status         SaleStatus  @default(COMPLETED)
  subtotal       Decimal     @default(0.00) @db.Decimal(12, 2)
  discountAmount Decimal     @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal     @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount    Decimal     @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  paidAmount     Decimal     @default(0.00) @map("paid_amount") @db.Decimal(12, 2)
  changeDue      Decimal     @default(0.00) @map("change_due") @db.Decimal(12, 2)
  idempotencyKey String?     @map("idempotency_key") @db.VarChar(128)
  notes          String?     @db.Text
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  deletedAt      DateTime?   @map("deleted_at")

  business Business      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  register Register?     @relation(fields: [registerId], references: [id], onDelete: SetNull)
  cashier  User          @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  items    SaleItem[]
  payments SalePayment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, id])
  @@index([tenantId, branchId])
  @@index([tenantId, cashierId])
  @@index([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@map("sales")
}

model SaleItem {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  saleId         String    @map("sale_id") @db.Uuid
  productId      String?   @map("product_id") @db.Uuid
  variantId      String?   @map("variant_id") @db.Uuid
  productName    String    @map("product_name") @db.VarChar(255)
  sku            String    @db.VarChar(128)
  unitPrice      Decimal   @map("unit_price") @db.Decimal(12, 2)
  quantity       Decimal   @default(1.000) @db.Decimal(10, 3)
  discountAmount Decimal   @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal   @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  subtotal       Decimal   @map("subtotal") @db.Decimal(12, 2)
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  business Business        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale     Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product  Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([tenantId, id])
  @@index([tenantId, saleId])
  @@index([tenantId, productId])
  @@map("sale_items")
}

model SalePayment {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  saleId        String            @map("sale_id") @db.Uuid
  paymentMethod SalePaymentMethod @map("payment_method")
  amount        Decimal           @db.Decimal(12, 2)
  reference     String?           @db.VarChar(128)
  status        SalePaymentStatus @default(SUCCESS)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId, id])
  @@index([tenantId, saleId])
  @@map("sale_payments")
}

model HeldCart {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  branchId      String    @map("branch_id") @db.Uuid
  registerId    String?   @map("register_id") @db.Uuid
  cashierId     String    @map("cashier_id") @db.Uuid
  cartReference String    @map("cart_reference") @db.VarChar(128)
  cartData      Json      @map("cart_data")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  business Business  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  register Register? @relation(fields: [registerId], references: [id], onDelete: SetNull)
  cashier  User      @relation(fields: [cashierId], references: [id], onDelete: Cascade)

  @@index([tenantId, id])
  @@index([tenantId, branchId])
  @@index([tenantId, cashierId])
  @@map("held_carts")
}

// ==========================================
// 7. MULTI-BRANCH INVENTORY & STOCK MOVEMENT LAYER
// ==========================================

model StockLevel {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  warehouseId      String          @map("warehouse_id") @db.Uuid
  productId        String          @map("product_id") @db.Uuid
  variantId        String?         @map("variant_id") @db.Uuid
  quantityOnHand   Decimal         @default(0.000) @map("quantity_on_hand") @db.Decimal(10, 3)
  quantityReserved Decimal         @default(0.000) @map("quantity_reserved") @db.Decimal(10, 3)
  reorderPoint     Decimal         @default(5.000) @map("reorder_point") @db.Decimal(10, 3)
  updatedAt        DateTime        @updatedAt @map("updated_at")

  business  Business        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, warehouseId, productId, variantId])
  @@index([tenantId, id])
  @@index([tenantId, warehouseId])
  @@index([tenantId, warehouseId, productId])
  @@map("stock_levels")
}

model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  warehouseId   String            @map("warehouse_id") @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  variantId     String?           @map("variant_id") @db.Uuid
  movementType  StockMovementType @map("movement_type")
  quantity      Decimal           @db.Decimal(10, 3)
  balanceBefore Decimal           @map("balance_before") @db.Decimal(10, 3)
  balanceAfter  Decimal           @map("balance_after") @db.Decimal(10, 3)
  referenceId   String?           @map("reference_id") @db.VarChar(128)
  notes         String?           @db.Text
  createdAt     DateTime          @default(now()) @map("created_at")

  business  Business        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([tenantId, id])
  @@index([tenantId, warehouseId, productId])
  @@index([tenantId, referenceId])
  @@index([tenantId, createdAt])
  @@map("stock_movements")
}

model StockAdjustment {
  id           String                @id @default(uuid()) @db.Uuid
  tenantId     String                @map("tenant_id") @db.Uuid
  warehouseId  String                @map("warehouse_id") @db.Uuid
  adjustedById String                @map("adjusted_by_id") @db.Uuid
  reason       StockAdjustmentReason
  status       StockAdjustmentStatus @default(APPLIED)
  notes        String?               @db.Text
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  business   Business              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse  Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  adjustedBy User                  @relation(fields: [adjustedById], references: [id], onDelete: Restrict)
  items      StockAdjustmentItem[]

  @@index([tenantId, id])
  @@index([tenantId, warehouseId])
  @@index([tenantId, createdAt])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  adjustmentId        String   @map("adjustment_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  variantId           String?  @map("variant_id") @db.Uuid
  countedQuantity     Decimal  @map("counted_quantity") @db.Decimal(10, 3)
  discrepancyQuantity Decimal  @map("discrepancy_quantity") @db.Decimal(10, 3)

  business   Business        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([tenantId, id])
  @@index([tenantId, adjustmentId])
  @@index([tenantId, productId])
  @@map("stock_adjustment_items")
}

model StockTransfer {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  sourceWarehouseId  String              @map("source_warehouse_id") @db.Uuid
  targetWarehouseId  String              @map("target_warehouse_id") @db.Uuid
  requestedById      String              @map("requested_by_id") @db.Uuid
  status             StockTransferStatus @default(PENDING)
  trackingNumber     String              @map("tracking_number") @db.VarChar(64)
  notes              String?             @db.Text
  dispatchedAt       DateTime?           @map("dispatched_at")
  receivedAt         DateTime?           @map("received_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  business        Business            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceWarehouse Warehouse           @relation("TransferSourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  targetWarehouse Warehouse           @relation("TransferTargetWarehouse", fields: [targetWarehouseId], references: [id], onDelete: Restrict)
  requestedBy     User                @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  items           StockTransferItem[]

  @@unique([tenantId, trackingNumber])
  @@index([tenantId, id])
  @@index([tenantId, sourceWarehouseId])
  @@index([tenantId, targetWarehouseId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("stock_transfers")
}

model StockTransferItem {
  id                 String          @id @default(uuid()) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  transferId         String          @map("transfer_id") @db.Uuid
  productId          String          @map("product_id") @db.Uuid
  variantId          String?         @map("variant_id") @db.Uuid
  quantityRequested  Decimal         @map("quantity_requested") @db.Decimal(10, 3)
  quantityDispatched Decimal         @default(0.000) @map("quantity_dispatched") @db.Decimal(10, 3)
  quantityReceived   Decimal         @default(0.000) @map("quantity_received") @db.Decimal(10, 3)

  business Business        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transfer StockTransfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([tenantId, id])
  @@index([tenantId, transferId])
  @@index([tenantId, productId])
  @@map("stock_transfer_items")
}


